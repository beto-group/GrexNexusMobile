<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="group.beto.grexnexus.child.pkgplaceholder00000">

    <!-- Network: Component may connect to localhost daemon / GitHub API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Grex Component Shell Placeholder Target"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name="group.beto.grexnexus.child.ChildActivity"
            android:exported="true"
            android:label="Grex Component Shell Placeholder Target"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|screenLayout"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Native Android Share Sheet Intent Receiver -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver
            android:name="group.beto.grexnexus.child.CompactWidgetProvider"
            android:exported="true"
            android:label="1x1 Compact Launcher">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/compact_widget_info" />
        </receiver>

        <receiver
            android:name="group.beto.grexnexus.child.GrexWidgetProvider"
            android:exported="true"
            android:label="2x2 Bot Quick Launcher">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/grex_widget_info" />
        </receiver>

        <receiver
            android:name="group.beto.grexnexus.child.CurrencyWidgetProvider"
            android:exported="true"
            android:label="3x1 FX Trade Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/currency_widget_info" />
        </receiver>

        <receiver
            android:name="group.beto.grexnexus.child.FullBannerWidgetProvider"
            android:exported="true"
            android:label="4x1 Full FX Banner">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/full_banner_widget_info" />
        </receiver>

        <receiver
            android:name="group.beto.grexnexus.child.DashboardWidgetProvider"
            android:exported="true"
            android:label="4x2 Master Dashboard">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dashboard_widget_info" />
        </receiver>

        <!-- FloatingBubbleService removed — replaced by Picture-in-Picture mode
             PiP requires zero permissions and works on all sideloaded APKs -->
    </application>
</manifest>
